{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/deucebucket/clanker/evaluation/conversations/report-v1.schema.json",
  "title": "Clanker conversation evaluation report v1",
  "type": "object",
  "required": ["report_schema_version", "corpus_version", "split", "corpus_sha256", "corpus_root_sha256", "compiler_sha256", "evaluator_sha256", "production_code_commit", "evaluation_commit", "backend", "modes", "development_correction_bundle", "paired_mode_differences", "semantic_fingerprint", "failure_count", "limitations"],
  "properties": {
    "report_schema_version": {"const": 1},
    "modes": {
      "type": "object",
      "required": ["sentence_only", "stateful", "transition_corrected"]
    },
    "semantic_fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
